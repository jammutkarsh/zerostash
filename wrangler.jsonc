{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zerostash",
	"main": "server/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"workers_dev": true,
	// Version preview URLs would expose every deployed version publicly; keep them off.
	"preview_urls": false,
	"assets": {
		// The SPA is static and free to serve; only /api/* invokes the Worker.
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/privacy-policy"]
	},
	// No database_id on purpose: the first deploy creates the database (see scripts/deploy.ts).
	"d1_databases": [{ "binding": "DB", "database_name": "zerostash", "migrations_dir": "migrations" }],
	// AI jobs (Phase 3). Declared now so the deploy spike proves Queues provision on every path;
	// if one can't, the plan's fallback is cron-only AI and this block goes away.
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "zerostash-jobs" }],
		"consumers": [{ "queue": "zerostash-jobs", "max_batch_size": 5, "max_retries": 3 }]
	},
	"triggers": { "crons": ["*/5 * * * *"] },
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}
