{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zerostash",
	"main": "server/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"workers_dev": true,
	// Version preview URLs would expose every deployed version publicly; keep them off.
	"preview_urls": false,
	"assets": {
		// The SPA is static and free to serve; only /api/* invokes the Worker.
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// No database_id on purpose: the first deploy creates the database (see scripts/deploy.ts).
	"d1_databases": [{ "binding": "DB", "database_name": "zerostash", "migrations_dir": "migrations" }],
	// Uploaded images and PDFs. Created on the first deploy too; R2 must be enabled on the account.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "zerostash-files" }],
	// Workers AI: the fallback model for tags/summaries, and page-to-text conversion (toMarkdown).
	"ai": { "binding": "AI" },
	// Background jobs: AI tagging/summaries, rules, webhooks (server/jobs.ts).
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "zerostash-jobs" }],
		"consumers": [{ "queue": "zerostash-jobs", "max_batch_size": 1, "max_retries": 3 }]
	},
	"triggers": { "crons": ["*/5 * * * *"] },
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}
