{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"types": [],
		"resolveJsonModule": true
	},
	"include": [
		"web/**/*.ts",
		"web/**/*.svelte",
		"shared/**/*.ts"
	],
	"exclude": [
		"shared/**/*.test.ts",
		"web/**/*.test.ts"
	]
}