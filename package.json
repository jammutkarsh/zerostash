{
	"name": "zerostash",
	"version": "1.0.0",
	"description": "Karakeep-compatible bookmarks on Cloudflare's free tier: Worker + D1 + R2, ₹0/month. Works with Karakeep's extension and apps.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "bun scripts/openapi.ts && vite",
		"build": "bun scripts/openapi.ts && vite build",
		"deploy": "bun scripts/deploy.ts",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"types": "wrangler types server/worker-configuration.d.ts",
		"check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
		"test": "bun test shared server web",
		"smoke": "bun scripts/smoke.ts"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "1.8.0",
		"@hono/zod-openapi": "1.6.3",
		"@trpc/client": "11.9.0",
		"@trpc/server": "11.9.0",
		"hono": "4.13.18",
		"superjson": "2.2.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.68.0",
		"@lucide/svelte": "1.72.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "^1.4.4",
		"@types/chrome": "0.3.7",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"wrangler": "4.160.0"
	}
}
