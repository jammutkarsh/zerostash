{
	"name": "zerostash",
	"version": "0.1.0",
	"description": "Karakeep-style bookmarks on Cloudflare's free tier: Worker + D1 + browser extension, ₹0/month.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"workspaces": [
		"extension"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build && bun scripts/openapi.ts",
		"deploy": "bun run build && (wrangler d1 migrations apply DB --remote || true) && wrangler deploy && wrangler d1 migrations apply DB --remote",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"types": "wrangler types server/worker-configuration.d.ts",
		"check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
		"test": "bun test shared server web",
		"smoke": "bun scripts/smoke.ts",
		"ext:build": "bun run --filter zerostash-extension build",
		"ext:zip": "bun run --filter zerostash-extension zip"
	},
	"cloudflare": {
		"bindings": {
			"ZEROSTASH_SECRET": {
				"description": "Your login secret for the web app and the browser extension. Generate one with `openssl rand -hex 32` (at least 32 characters)."
			}
		}
	},
	"engines": {
		"bun": ">=1.3"
	},
	"dependencies": {
		"@hono/zod-openapi": "1.6.3",
		"hono": "4.13.18",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.68.0",
		"@lucide/svelte": "1.72.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "^1.4.4",
		"@types/chrome": "0.3.7",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"wrangler": "4.160.0"
	}
}
