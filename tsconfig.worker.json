{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": [
			"ES2022"
		],
		"types": [
			"./server/worker-configuration.d.ts"
		],
		"resolveJsonModule": true
	},
	"include": [
		"server/**/*.ts",
		"shared/**/*.ts"
	],
	"exclude": [
		"**/*.test.ts",
		"server/test/**"
	]
}